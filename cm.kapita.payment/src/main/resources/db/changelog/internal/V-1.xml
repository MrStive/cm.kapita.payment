<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="payment-4:1" author="domeni.ngameni">
        <createTable tableName="t_outbox_event">
            <column name="c_id" type="varchar(36)">
                <constraints nullable="false" primaryKey="true"
                             primaryKeyName="pk_t_outbox_event" />
            </column>
            <column name="c_aggregate_id" type="varchar(36)">
                <constraints nullable="false" />
            </column>
            <column name="c_type" type="varchar(100)">
                <constraints nullable="false" />
            </column>
            <column name="c_payload" type="text">
                <constraints nullable="false" />
            </column>
            <column name="c_status" type="varchar(32)">
                <constraints nullable="false" />
            </column>
            <column name="c_created_at" type="timestamp">
                <constraints nullable="false" />
            </column>
            <column name="c_processed_at" type="timestamp" />
        </createTable>
        <createIndex tableName="t_outbox_event" indexName="idx_outbox_status_created">
            <column name="c_status" />
            <column name="c_created_at" />
        </createIndex>
    </changeSet>
</databaseChangeLog>
